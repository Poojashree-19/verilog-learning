`timescale 1ns/1ps

module branch_decision_tb;

    logic Branch;
    logic [2:0] funct3;

    logic Zero;
    logic less_than;
    logic less_than_u;

    logic PCSrc;

    // DUT
    branch_decision uut (

        .Branch(Branch),
        .funct3(funct3),
        .Zero(Zero),
        .less_than(less_than),
        .less_than_u(less_than_u),
        .PCSrc(PCSrc)

    );

    initial begin
      
      
       // Generate waveform
        $dumpfile("branch_decision_tb.vcd");
        $dumpvars(0, branch_decision_tb);

        $display("Time\tBranch\tfunct3\tZero\tLT\tLTU\tPCSrc");

        $monitor("%0t\t%b\t%b\t%b\t%b\t%b\t%b",
                 $time,
                 Branch,
                 funct3,
                 Zero,
                 less_than,
                 less_than_u,
                 PCSrc);

        //--------------------------------------------------
        // BEQ
        //--------------------------------------------------

        Branch = 1;
        funct3 = 3'b000;

        Zero = 1;
        less_than = 0;
        less_than_u = 0;
        #10;

        Zero = 0;
        #10;

        //--------------------------------------------------
        // BNE
        //--------------------------------------------------

        funct3 = 3'b001;

        Zero = 0;
        #10;

        Zero = 1;
        #10;

        //--------------------------------------------------
        // BLT
        //--------------------------------------------------

        funct3 = 3'b100;

        less_than = 1;
        #10;

        less_than = 0;
        #10;

        //--------------------------------------------------
        // BGE
        //--------------------------------------------------

        funct3 = 3'b101;

        less_than = 0;
        #10;

        less_than = 1;
        #10;

        //--------------------------------------------------
        // BLTU
        //--------------------------------------------------

        funct3 = 3'b110;

        less_than_u = 1;
        #10;

        less_than_u = 0;
        #10;

        //--------------------------------------------------
        // BGEU
        //--------------------------------------------------

        funct3 = 3'b111;

        less_than_u = 0;
        #10;

        less_than_u = 1;
        #10;

        //--------------------------------------------------
        // Branch Disabled
        //--------------------------------------------------

        Branch = 0;
        funct3 = 3'b000;
        Zero = 1;
        less_than = 1;
        less_than_u = 1;
        #10;

        $finish;

    end

endmodule
